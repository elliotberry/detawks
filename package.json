{
    "name": "detawks",
    "version": "0.1.19",
    "description": "An opinionated mass file renamer in Node. Meant to be similar to the venerable detox unix application, but, crappier, since it's my attempt in nodejs.",
    "keywords": [
        "renaming",
        "detox",
        "cli",
        "slugify",
        "files"
    ],
    "repository": {
        "type": "git",
        "url": "git@github.com:elliotberry/detawks.git"
    },
    "license": "Unlicense",
    "author": "ɛʟʟɨօȶ b",
    "type": "module",
    "main": "./index.js",
    "module": "./index.js",
    "bin": "./cli.js",
    "files": [
        "lib/**/*",
        "index.js",
        "cli.js",
        "default.detawksrc"
    ],
    "scripts": {
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "release": "release-it --ci",
        "test": "node ./test/test.js"
    },
    "prettier": {
        "trailingComma": "es5",
        "tabWidth": 4,
        "semi": false,
        "singleQuote": true
    },
    "dependencies": {
        "chalk": "^5.6.2",
        "fdir": "^6.5.0",
        "picomatch": "^4.x",
        "rc": "^1.2.8",
        "text-case": "^1.2.11",
        "yargs": "^18.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.4.0",
        "eslint-plugin-import-x": "^4.16.2",
        "eslint-plugin-node-dependencies": "^2.2.0",
        "eslint-plugin-package-json": "^1.1.0",
        "eslint-plugin-perfectionist": "^5.9.0",
        "eslint-plugin-simple-import-sort": "^13.0.0",
        "eslint-plugin-sonarjs": "^4.0.3",
        "eslint-plugin-unicorn": "^64.0.0",
        "prettier": "^3.8.3",
        "release-it": "^20.0.1"
    },
    "engines": {
        "node": ">=20.19.0"
    },
    "os": [
        "linux",
        "darwin"
    ],
    "publishConfig": {
        "executableFiles": [
            "./cli.js"
        ],
        "access": "public",
        "registry": "https://registry.npmjs.org"
    }
}
